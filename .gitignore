# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/
pb_data/
grroxy_db/
builds*/
build/
bin/

# Node.js dependencies
node_modules/
**/node_modules/
*/electron/dist/

# Release archives from cmd/release.sh (hundreds of MB per platform)
/dist/

# Staged AI CLI bridges. Build output only — cmd/electron/build.sh wipes and
# regenerates this on every run from the sources in the cybernetic-ui repo.
# Scoped to this path on purpose: a bare `bridges/` would also swallow the
# bridge sources if they are ever moved into this repo.
cmd/electron/bridges/

cmd/grroxy/builds*

# macOS system files
.DS_Store
**/.DS_Store
